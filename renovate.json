{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "addLabels": ["renovate"],
  "timezone": "Asia/Tokyo",
  "extends": [
    "config:recommended",
    ":configMigration",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "reviewers": ["hrdtbs"],
  "prConcurrentLimit": 2,
  "major": {
    "minimumReleaseAge": "7 days"
  },
  "minor": {
    "minimumReleaseAge": "7 days"
  },
  "patch": {
    "minimumReleaseAge": "7 days",
    "automerge": true
  },
  "separateMinorPatch": true,
  "ignoreDeps": [
    "github.com/matsuri-tech/m2m-core",
    "github.com/elastic/go-elasticsearch/v7"
  ],
  "schedule": ["every weekday"],
  "packageRules": [
    {
      "description": "major 以外を 1 本の PR にまとめ、月 1 回（毎月 1 日）作って automerge する。Renovate の実行間隔が数時間あるため時間帯は絞らない。group:allNonMajor の preset は groupSlug を持ち、groupName だけを上書きする後続のルールが同じブランチに衝突するため使わない。groupName を持つ後続のルールがあればそちらが優先される",
      "matchPackageNames": ["*"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies",
      "schedule": ["* * 1 * *"],
      "automerge": true
    },
    {
      "matchDatasources": ["golang-version"],
      "matchUpdateTypes": ["patch"],
      "enabled": false
    },
    {
      "groupName": "High update frequency and low impact Node packages",
      "matchPackageNames": ["aws-cdk"],
      "schedule": ["after 12:00 on Monday"]
    },
    {
      "groupName": "High update frequency and low impact Go packages",
      "matchPackageNames": [
        "google.golang.org/api",
        "golang.org/x/oauth2",
        "github.com/aws/aws-sdk-go",
        "github.com/aws/aws-sdk-go/awssdk/v2"
      ],
      "schedule": ["after 12:00 on Monday"]
    },
    {
      "matchDepTypes": ["action"],
      "matchPackageNames": ["actions/{/,}**", "matsuri-tech/{/,}**"],
      "pinDigests": false
    }
  ]
}
